#!/bin/sh
# Launcher: desktop app when run without arguments, CLI when arguments are given.
HERE="$(dirname "$(readlink -f "$0")")"
for D in "$HERE" "$HERE/.." /opt/iuk-netscope; do
  [ -f "$D/iuk_netscope.py" ] && break
done
if [ $# -eq 0 ]; then exec python3 "$D/iuk_netscope_gui.py"; else exec python3 "$D/iuk_netscope.py" "$@"; fi
